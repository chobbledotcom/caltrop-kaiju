{
	"threshold": 0,
	"reporters": ["console", "json"],
	"output": ".jscpd-report",
	"ignore": [
		"**/node_modules/**",
		"**/packages/**/index.js"
	],
	"format": ["javascript", "json"],
	"absolute": false,
	"gitignore": true,
	"exitCode": 1,
	"minLines": 1,
	"minTokens": 40,
	"path": ["src", "test"]
}
