{
	"name": "caltrop-kaiju",
	"version": "0.1.0",
	"type": "module",
	"packageManager": "bun@1.3.6",
	"imports": {
		"#lib/*": "./src/_lib/*",
		"#src/*": "./src/*",
		"#test/*": "./test/*",
		"#toolkit/*": "./packages/js-toolkit/*"
	},
	"scripts": {
		"test": "bun test/run-tests.js",
		"test:unit": "bun test test/unit",
		"typecheck": "tsc --noEmit",
		"cpd": "jscpd",
		"cpd:fp": "jscpd packages/js-toolkit/fp --min-tokens 12",
		"knip": "knip",
		"knip:fix": "knip --fix",
		"lint": "bunx @biomejs/biome check --error-on-warnings .",
		"lint:fix": "bunx @biomejs/biome check --write .",
		"precommit": "node test/precommit.js"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "^20.0.11",
		"@types/bun": "^1.3.6",
		"happy-dom": "^20.0.11",
		"jscpd": "^4.0.5",
		"knip": "^5.38.0",
		"typescript": "^5.9.3"
	},
	"dependencies": {}
}
